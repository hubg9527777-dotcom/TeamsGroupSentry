{
  "manifest_version": 3,
  "name": "TeamsGroupSentry",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "本地 Teams 群成员变动观察、重点群组缓存变动触发、人员审核与安全备份",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.live.com/*"
      ],
      "js": [
        "lib/logic.js",
        "lib/name-core.js",
        "lib/isolated-reader.js",
        "content.js",
        "overlay/overlay.js"
      ],
      "run_at": "document_start",
      "css": [
        "overlay/overlay.css"
      ]
    },
    {
      "matches": [
        "https://teams.live.com/*"
      ],
      "js": [
        "lib/cache-watch.js",
        "page-reader.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TeamsGroupSentry",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"
  }
}
